{
  "name": "ZQM Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "github.copilot",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install pytest ruff black",
  "remoteUser": "vscode"
}
